# Spring Boot Environment Variables Template
# Copy this file to .env and modify values if needed
# Default values below work out of the box for local testing

# JWT Configuration
JWT_SECRET=collabus-dev-secret-key-for-local-testing-only-32chars
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# 로그인 · 회원가입 IP 단위 제한. E2E 는 한 주소에서 로그인을 많이 해 로컬에서는 끔
RATE_LIMIT_ENABLED=false

# MySQL Configuration
DB_HOST=localhost
DB_PORT=3307
DB_NAME=collabus
DB_USERNAME=collabus
DB_PASSWORD=collabus1234
DB_ROOT_PASSWORD=rootpassword1234
